# Local PostgreSQL settings. Change the password before using this outside development.
POSTGRES_DB=openlinklearn
POSTGRES_USER=openlinklearn
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
APP_PORT=8080

# Application settings.
APP_TIMEZONE=Etc/UTC
APP_ALLOWED_ORIGIN=http://localhost:4200
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:admin@openlinklearn.invalid
VAPID_ENABLED=false