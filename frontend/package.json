{
  "name": "openlinklearn-frontend",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.html\"",
