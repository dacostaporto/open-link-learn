{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/*.css",
          "/*.js",
          "/manifest.webmanifest",
          "/icons/**",
          "/fonts/**"
        ]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/api",
    "!/api/**",
    "!/**/*.*"
  ]
}